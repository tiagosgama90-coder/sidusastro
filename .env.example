# ── Firebase (client) ────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Mesma API key no servidor (Netlify) para fallback de email de verificação
FIREBASE_WEB_API_KEY=your-api-key

# ── Site URL (fallbacks no servidor quando Origin não está presente) ──────────
SITE_URL=https://your-domain.com

# ── Google reCAPTCHA v2 — obrigatório em produção ───────────────────────────
# https://www.google.com/recaptcha/admin — tipo "Checkbox"
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# ── Google AdSense (opcional) ───────────────────────────────────────────────
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT=0000000000

# ── Google Analytics 4 (opcional — só após consentimento de cookies) ──────────
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Stripe (obrigatório para pagamentos) ────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── IA (Netlify Functions — servidor) ───────────────────────────────────────
# Por defeito: Pollinations (sem chave). Opcional: Groq, Gemini, OpenRouter
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Firebase Admin — JSON da service account (Netlify only, uma linha)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project",...}
