VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=sidus-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sidus-app
VITE_FIREBASE_STORAGE_BUCKET=sidus-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Mesma API key no servidor (Netlify) para fallback de email de verificação
FIREBASE_WEB_API_KEY=AIzaSy...

# Google reCAPTCHA v2 — OBRIGATÓRIO em produção (sidusastro.com)
# Cria em https://www.google.com/recaptcha/admin (tipo "Caixa de verificação")
# Domínios: sidusastro.com, www.sidusastro.com, sidusastro.netlify.app
# A chave abaixo é só para localhost (teste Google):
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# Google Analytics 4 — sidusastro.com
VITE_GA_MEASUREMENT_ID=G-18FPC8HYE8

# Google AdSense — sidusastro.com (Publisher ID público; slot após criar unidade no painel)
VITE_ADSENSE_CLIENT=ca-pub-2807052149540484
VITE_ADSENSE_SLOT=7205155875

# Stripe (obrigatório para pagamentos)
# Chave pública — opcional no frontend (Checkout é hosted)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Chaves secretas — APENAS no Netlify (nunca no .env commitado se partilhado)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── IA GRATUITA (Netlify — servidor) ─────────────────────────────────────────
# Por defeito usa Pollinations (SEM chave, SEM custo).
# Opcional — melhor qualidade, ainda grátis:
#   Groq:   https://console.groq.com  → GROQ_API_KEY (grátis)
#   Gemini: https://aistudio.google.com/apikey → GEMINI_API_KEY (quota grátis)
#   OpenRouter: https://openrouter.ai → OPENROUTER_API_KEY (modelos :free)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# OpenAI (PAGO) — desactivado por defeito. Só activa se quiseres pagar:
# ALLOW_PAID_OPENAI=true
# OPENAI_API_KEY=sk-...

# Firebase Admin — JSON completo da service account (Netlify only, uma linha)
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"sidus-app",...}
