rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny([
          'isPremium', 'premiumAt', 'stripeCustomerId', 'stripeSubscriptionId',
          'mapaCompleto', 'mapaCompletoAt'
        ]);

      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isPremium', 'premiumAt', 'stripeCustomerId', 'stripeSubscriptionId',
          'mapaCompleto', 'mapaCompletoAt'
        ])
        && (
          (!resource.data.get('dadosTravados', false) && !resource.data.get('mapaGerado', false))
          || request.resource.data.get('dados') == resource.data.get('dados')
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tarotLeiturasUsadas'])
        );
    }
  }
}
