rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function dadosNataisCoreIguais(antigos, novos) {
      return antigos.get('nome', null) == novos.get('nome', null)
        && antigos.get('data', null) == novos.get('data', null)
        && antigos.get('hora', null) == novos.get('hora', null)
        && antigos.get('cidade', null) == novos.get('cidade', null);
    }

    function dadosPermitemReparacao(antigos) {
      return antigos == null
        || !antigos.keys().hasAll(['nome', 'data', 'hora', 'cidade'])
        || !antigos.keys().hasAll(['localizacao']);
    }

    function podeActualizarDadosNatais() {
      let antigos = resource.data.get('dados', null);
      return (!resource.data.get('dadosTravados', false) && !resource.data.get('mapaGerado', false))
        || dadosPermitemReparacao(antigos)
        || !request.resource.data.keys().hasAll(['dados'])
        || request.resource.data.get('dados') == antigos
        || dadosNataisCoreIguais(antigos, request.resource.data.get('dados'));
    }

    function isPremiumUser(userId) {
      let d = get(/databases/$(database)/documents/users/$(userId)).data;
      return d.get('isPremium', false) == true
        || d.get('mapaCompleto', false) == true
        || d.keys().hasAny(['stripeSubscriptionId'])
        || (d.keys().hasAny(['premiumUntil']) && d.premiumUntil > request.time);
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny([
          'isPremium', 'premiumAt', 'stripeCustomerId', 'stripeSubscriptionId',
          'mapaCompleto', 'mapaCompletoAt'
        ]);

      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isPremium', 'premiumAt', 'stripeCustomerId', 'stripeSubscriptionId',
          'mapaCompleto', 'mapaCompletoAt', 'interpretacaoMapa'
        ])
        && (
          podeActualizarDadosNatais()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tarotLeiturasUsadas'])
        );

      // Notificações diárias (Premium) — subcoleção gerida pelo próprio utilizador
      match /notifications/{notificationId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;

        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && isPremiumUser(userId)
          && request.resource.data.keys().hasOnly(['signo', 'createdAt', 'ativo', 'lang'])
          && request.resource.data.ativo == true;
      }
    }

    // Códigos de referência — leitura para resolver ?ref=; escrita só do próprio código
    match /referral_codes/{code} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid);
    }
  }
}
