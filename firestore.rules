rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function dadosNataisCoreIguais(antigos, novos) {
      return antigos.get('nome', null) == novos.get('nome', null)
        && antigos.get('data', null) == novos.get('data', null)
        && antigos.get('hora', null) == novos.get('hora', null)
        && antigos.get('cidade', null) == novos.get('cidade', null);
    }

    function dadosPermitemReparacao(antigos) {
      return antigos == null
        || !antigos.keys().hasAll(['nome', 'data', 'hora', 'cidade'])
        || !antigos.keys().hasAll(['localizacao']);
    }

    function podeActualizarDadosNatais() {
      let antigos = resource.data.get('dados', null);
      return (!resource.data.get('dadosTravados', false) && !resource.data.get('mapaGerado', false))
        || dadosPermitemReparacao(antigos)
        || !request.resource.data.keys().hasAll(['dados'])
        || request.resource.data.get('dados') == antigos
        || dadosNataisCoreIguais(antigos, request.resource.data.get('dados'));
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny([
          'isPremium', 'premiumAt', 'stripeCustomerId', 'stripeSubscriptionId',
          'mapaCompleto', 'mapaCompletoAt'
        ]);

      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isPremium', 'premiumAt', 'stripeCustomerId', 'stripeSubscriptionId',
          'mapaCompleto', 'mapaCompletoAt'
        ])
        && (
          podeActualizarDadosNatais()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tarotLeiturasUsadas'])
        );
    }
  }
}
