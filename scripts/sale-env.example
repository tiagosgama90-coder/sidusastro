VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Same API key on Netlify server (email verification fallback)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# Google reCAPTCHA v2 — required in production
# Create at https://www.google.com/recaptcha/admin (checkbox type)
# Domains: yourdomain.com, www.yourdomain.com, your-site.netlify.app
# Test key for localhost only:
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# Google Analytics 4 (optional — leave empty to disable)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense (optional — leave empty to disable ads)
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=

# Stripe (required for payments)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_...
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Free AI backends (Netlify server) ────────────────────────────────────────
# Default: Pollinations (no key). Optional:
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Paid OpenAI — disabled by default:
# ALLOW_PAID_OPENAI=true
# OPENAI_API_KEY=sk-...

# Firebase Admin — full service account JSON (Netlify only, single line)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project",...}
